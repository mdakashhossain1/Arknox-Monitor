# ArknoxMonitor - copy these lines into the site's own .env
# After editing on a server that uses config:cache, run: php artisan config:clear

# REQUIRED. Token for every API call (sent as the X-Monitor-Token header).
# Use a long random value, different for every site. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
# If empty, every API call returns 401.
ARKNOX_MONITOR_SECRET=

# Payment enforcement (banner, then suspension when a past invoice is unpaid).
# Set to false to turn the banner and suspension off. Usage tracking and billing still run.
ARKNOX_PAYMENT_LOCK_ENABLED=true

# Days after an invoice falls due (1st of the next month) when the site still works
# but shows the "payment pending" banner. 0 = suspend immediately.
ARKNOX_GRACE_DAYS=5

# Redis usage tracking, billed like Upstash pay-as-you-go.
#   auto  = track only if cache, session or queue uses redis
#   true  = always track (use if the site calls Redis:: directly)
#   false = never track
ARKNOX_REDIS_TRACKING=auto
ARKNOX_REDIS_CONNECTION=default

# Cloudflare R2 (only needed if the site uploads files through R2StorageService).
# The access keys and endpoint are used by the "r2" disk in config/filesystems.php.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Only on the OTHER site that calls this site's API (dashboard / billing site):
# ARKNOX_SECRET=same-value-as-ARKNOX_MONITOR_SECRET-of-the-monitored-site
# ARKNOX_BASE_URL=https://monitored-site.com/arknox-monitor
